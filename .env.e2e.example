# Copy to .env.e2e (git-ignored) and fill in the values.
# Admin created by the backend seed (ACM-Backend/src/db/seed.ts).
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Optional. The defaults are shown.
# E2E_BASE_URL=http://localhost:4200          # frontend under test
# E2E_APP_API_ORIGIN=http://localhost:5002    # API origin that this frontend calls
# E2E_API_URL=http://localhost:5003/api       # throwaway API started for the run
# E2E_BACKEND_DIR=../ACM-Backend              # backend checkout the throwaway API runs
# E2E_KEEP_STACK=1                            # keep the throwaway API and database after the run
# E2E_SKIP_STACK=1                            # do not start it: E2E_API_URL is provided and seeded
